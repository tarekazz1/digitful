---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Social Media - Digitful';
const pageDescription = 'Digitful helps businesses build social media around a clear point of view, a recognizable voice, and content for the right people.';
const pageCanonical = 'https://digitful.ca/social-media/';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageCanonical}>
  <main class="page-theme page-theme--social social-page">
    <section class="social-hero">
      <div class="container social-hero__grid">
        <div class="social-hero__copy">
          <span class="eyebrow">Social media</span>
          <h1>Social media should give people a reason to pay attention.</h1>
          <p class="lead">
            A clear point of view, a recognizable voice, and content built for the people you actually want to reach.
          </p>
        </div>

        <div class="social-hero__collage" aria-hidden="true">
          <span class="social-hero__paper"></span>
          <span class="social-hero__bubble social-hero__bubble--coral"></span>
          <span class="social-hero__bubble social-hero__bubble--teal"></span>

          <svg class="social-hero__megaphone" viewBox="0 0 520 420" focusable="false">
            <g class="social-hero__megaphone-body">
              <path d="M182 174 L332 102 L332 318 L182 246 Z" />
              <path d="M142 181 L188 174 L188 246 L142 239 Z" />
              <path d="M333 102 C383 112 413 151 413 210 C413 269 383 308 333 318 Z" />
            </g>
            <path class="social-hero__megaphone-handle" d="M202 242 L270 270 L238 356 L180 329 Z" />
            <path class="social-hero__megaphone-cut" d="M338 137 C367 151 381 174 381 210 C381 246 367 269 338 283 Z" />
            <g class="social-hero__sound">
              <path d="M426 145 L467 115" />
              <path d="M438 208 L493 208" />
              <path d="M426 271 L467 301" />
            </g>
          </svg>

          <span class="social-hero__annotation technical-annotation">Make it recognizable</span>
          <span class="social-hero__label social-hero__label--one">Point of view</span>
          <span class="social-hero__label social-hero__label--two">Voice</span>
          <span class="social-hero__label social-hero__label--three">Right people</span>
        </div>
      </div>
    </section>

    <section class="social-section social-problems">
      <div class="container">
        <div class="social-section__head">
          <span class="eyebrow">Where it usually gets stuck</span>
          <h2>Being active is not the same as being memorable.</h2>
        </div>

        <div class="social-problems__grid">
          <article class="social-problem">
            <span class="social-problem__mark" aria-hidden="true">01</span>
            <h3>The brand could be anyone</h3>
            <p>The content looks polished, but there is nothing distinctive enough to remember.</p>
          </article>
          <article class="social-problem">
            <span class="social-problem__mark" aria-hidden="true">02</span>
            <h3>The message keeps changing</h3>
            <p>Every post says something different, so the brand never becomes clear.</p>
          </article>
          <article class="social-problem">
            <span class="social-problem__mark" aria-hidden="true">03</span>
            <h3>You are talking to everyone</h3>
            <p>The content gets seen, but not necessarily by the people you want more of.</p>
          </article>
          <article class="social-problem">
            <span class="social-problem__mark" aria-hidden="true">04</span>
            <h3>Posting becomes the goal</h3>
            <p>The calendar stays full, but it is hard to explain what all that activity is actually doing for the business.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="social-good">
      <div class="container social-good__grid">
        <div class="social-good__intro">
          <span class="eyebrow">What good social media should do</span>
          <h2>Make the brand easier to recognize and harder to forget.</h2>
        </div>

        <div class="social-good__list">
          <article class="social-good__item">
            <span aria-hidden="true">01</span>
            <div>
              <h3>Make the brand recognizable</h3>
              <p>People should start to recognize how you think, what you value, and why the business feels different.</p>
            </div>
          </article>
          <article class="social-good__item">
            <span aria-hidden="true">02</span>
            <div>
              <h3>Speak to the right people</h3>
              <p>Good content reflects the questions, priorities, and problems your audience actually has.</p>
            </div>
          </article>
          <article class="social-good__item">
            <span aria-hidden="true">03</span>
            <div>
              <h3>Build familiarity over time</h3>
              <p>Most people are not ready to act today. Good social gives them a reason to remember you later.</p>
            </div>
          </article>
          <article class="social-good__item">
            <span aria-hidden="true">04</span>
            <div>
              <h3>Give attention somewhere to go</h3>
              <p>Attention should lead naturally to a useful next step.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="social-section social-method">
      <div class="container">
        <div class="social-section__head social-section__head--method">
          <span class="eyebrow">How we work on it</span>
          <h2>A useful social system starts before the first post.</h2>
        </div>

        <div class="social-method__grid">
          <article class="social-method__step">
            <span class="social-method__number">01</span>
            <div>
              <h3>Get the message clear</h3>
              <p>Define what the business needs to be known for, how the brand should sound, and what is worth repeating.</p>
            </div>
          </article>
          <article class="social-method__step">
            <span class="social-method__number">02</span>
            <div>
              <h3>Focus on the right people</h3>
              <p>Shape the content around the people you actually want to reach and what matters to them.</p>
            </div>
          </article>
          <article class="social-method__step">
            <span class="social-method__number">03</span>
            <div>
              <h3>Build the content system</h3>
              <p>Turn the message into repeatable themes, formats, and a publishing rhythm the team can realistically maintain.</p>
            </div>
          </article>
          <article class="social-method__step">
            <span class="social-method__number">04</span>
            <div>
              <h3>Learn from the response</h3>
              <p>Look beyond likes and reach to see what earns attention, creates interest, and helps move the right people closer.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="social-cta">
      <div class="container social-cta__grid">
        <div>
          <span class="eyebrow">The next step</span>
          <h2>Social media should not end at the post.</h2>
        </div>
        <div class="social-cta__copy">
          <p class="social-cta__lead">It should reinforce the message, reach the right people, and make the next step easier.</p>
          <p>If the content feels generic, inconsistent, or busy without much purpose, we can help fix the system behind it.</p>
          <a href="/contact/?service=social-media" class="btn btn-primary btn-lg px-4">Tell us what’s not working</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .social-page {
    --social-accent: var(--site-accent);
    --social-rule: var(--ds-rule-strong);
    overflow: clip;
  }

  .social-hero {
    padding-block: clamp(4rem, 8vw, 7.5rem) var(--space-section);
    border-bottom: var(--social-rule);
  }

  .social-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(19rem, 0.84fr);
    gap: clamp(2.75rem, 7vw, 7rem);
    align-items: center;
  }

  .social-hero__copy {
    max-width: 50rem;
  }

  .social-hero__copy .eyebrow,
  .social-section__head .eyebrow,
  .social-good__intro .eyebrow,
  .social-cta .eyebrow {
    margin-bottom: 1.25rem;
  }

  .social-hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: var(--type-display-xl);
    line-height: 0.91;
    letter-spacing: -0.045em;
  }

  .social-hero .lead {
    max-width: 42rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.55;
  }

  .social-hero__collage {
    position: relative;
    min-height: 27rem;
    isolation: isolate;
  }

  .social-hero__paper {
    position: absolute;
    inset: 12% 10% 14% 14%;
    z-index: -2;
    background:
      linear-gradient(var(--site-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--site-border-subtle) 1px, transparent 1px),
      var(--site-surface);
    background-size: var(--technical-grid-size) var(--technical-grid-size);
    border: var(--social-rule);
    box-shadow: var(--print-offset-lg) var(--site-mustard);
    transform: rotate(-1.4deg);
  }

  .social-hero__bubble {
    position: absolute;
    z-index: -1;
    border: var(--social-rule);
    border-radius: 50%;
    transition: transform var(--motion-standard) var(--motion-ease);
    animation: social-bubble-in var(--motion-standard) var(--motion-ease) both;
  }

  .social-hero__bubble--coral {
    width: clamp(7rem, 12vw, 10rem);
    height: clamp(7rem, 12vw, 10rem);
    top: 3%;
    left: 12%;
    background: var(--site-accent);
    animation-delay: 30ms;
  }

  .social-hero__bubble--teal {
    width: clamp(6rem, 10vw, 8.25rem);
    height: clamp(6rem, 10vw, 8.25rem);
    right: 7%;
    bottom: 7%;
    background: var(--site-teal);
    animation-delay: 90ms;
  }

  .social-hero__megaphone {
    position: absolute;
    width: 82%;
    max-width: 31rem;
    left: 8%;
    top: 4%;
    z-index: 1;
    overflow: visible;
    filter: drop-shadow(0.45rem 0.55rem 0 var(--brand-ink));
    transform: rotate(-4deg);
    transition: transform var(--motion-standard) var(--motion-ease);
    animation: social-collage-in var(--motion-standard) var(--motion-ease) both;
  }

  .social-hero__megaphone-body {
    fill: var(--brand-paper);
    stroke: var(--brand-ink);
    stroke-width: 10;
    stroke-linejoin: round;
  }

  .social-hero__megaphone-handle {
    fill: var(--brand-ink);
    stroke: var(--brand-ink);
    stroke-width: 8;
    stroke-linejoin: round;
  }

  .social-hero__megaphone-cut {
    fill: var(--site-surface);
    stroke: var(--brand-ink);
    stroke-width: 9;
  }

  .social-hero__sound {
    fill: none;
    stroke: var(--brand-ink);
    stroke-width: 9;
    stroke-linecap: round;
  }

  .social-hero__annotation {
    position: absolute;
    top: 7%;
    right: 0;
    z-index: 3;
    transform: rotate(3deg);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-hero__label {
    position: absolute;
    z-index: 3;
    padding: 0.38rem 0.5rem;
    color: var(--site-text);
    background: var(--site-surface);
    border-bottom: var(--ds-rule-thin-width) solid var(--site-border);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-hero__label--one {
    top: 20%;
    right: 0;
  }

  .social-hero__label--two {
    top: 49%;
    right: 3%;
  }

  .social-hero__label--three {
    right: 0;
    bottom: 14%;
  }

  .social-hero__collage:hover .social-hero__megaphone {
    transform: rotate(-2deg) translate(0.25rem, -0.1rem);
  }

  .social-hero__collage:hover .social-hero__bubble--coral {
    transform: translate(0.45rem, -0.35rem);
  }

  .social-hero__collage:hover .social-hero__bubble--teal {
    transform: translate(-0.4rem, 0.3rem);
  }

  .social-hero__collage:hover .social-hero__annotation {
    transform: rotate(1deg) translateX(-0.2rem);
  }

  .social-hero__collage:hover .social-hero__label--one {
    transform: translateX(-0.3rem);
  }

  .social-hero__collage:hover .social-hero__label--two {
    transform: translateX(-0.45rem);
  }

  .social-hero__collage:hover .social-hero__label--three {
    transform: translateX(-0.25rem);
  }

  @keyframes social-bubble-in {
    from {
      opacity: 0;
      transform: scale(0.86);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes social-collage-in {
    from {
      opacity: 0;
      transform: rotate(-6deg) translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: rotate(-4deg) translateY(0);
    }
  }

  .social-section {
    padding-block: var(--space-section);
  }

  .social-section__head {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-editorial-gap);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.75rem);
  }

  .social-section__head .eyebrow {
    align-self: start;
  }

  .social-section__head h2,
  .social-good__intro h2,
  .social-cta h2 {
    margin: 0;
    font-size: var(--type-display-lg);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .social-problems__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: var(--social-rule);
  }

  .social-problem {
    position: relative;
    padding: clamp(1.6rem, 2.5vw, 2.35rem) clamp(1.25rem, 2vw, 2rem) 0;
    transition:
      transform var(--motion-fast) var(--motion-ease),
      border-color var(--motion-fast) var(--motion-ease);
  }

  .social-problem + .social-problem {
    border-left: var(--social-rule);
  }

  .social-problem:hover {
    transform: translateY(-0.18rem);
  }

  .social-problem__mark {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--social-accent);
    font-family: var(--type-display);
    font-size: 1.15rem;
    font-weight: var(--type-display-weight);
    letter-spacing: 0.06em;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-problem:hover .social-problem__mark {
    transform: translateX(0.25rem);
  }

  .social-problem h3,
  .social-good__item h3,
  .social-method__step h3 {
    margin: 0 0 0.75rem;
    font-size: var(--type-title-lg);
    line-height: 1;
  }

  .social-problem p,
  .social-good__item p,
  .social-method__step p,
  .social-cta p {
    margin: 0;
    line-height: 1.6;
  }

  .social-problem p {
    max-width: 31rem;
  }

  .social-good {
    padding-block: var(--space-section-wide);
    color: var(--brand-ink);
    background: var(--site-teal);
    border-block: var(--social-rule);
  }

  .social-good :global(.eyebrow),
  .social-good h2,
  .social-good h3,
  .social-good p {
    color: var(--brand-ink);
  }

  .social-good__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .social-good__intro {
    position: sticky;
    top: 7rem;
  }

  .social-good__list {
    border-top: var(--ds-rule-width) solid var(--brand-ink);
  }

  .social-good__item {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.6rem;
    padding-right: 1.25rem;
    border-bottom: var(--ds-rule-width) solid var(--brand-ink);
  }

  .social-good__item::after {
    content: '';
    position: absolute;
    width: 0.58rem;
    height: 0.58rem;
    right: 0;
    top: 50%;
    border: var(--ds-rule-thin-width) solid var(--brand-ink);
    border-radius: 50%;
    background: var(--site-accent);
    transform: translateY(-50%);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-good__item:hover::after {
    transform: translate(-0.7rem, -50%);
  }

  .social-good__item > span {
    padding-top: 0.1rem;
    color: var(--site-accent);
    font-family: var(--type-display);
    font-size: 1.2rem;
    font-weight: var(--type-display-weight);
  }

  .social-good__item p {
    max-width: 40rem;
    opacity: 0.88;
  }

  .social-section__head--method {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .social-method__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
    border-top: var(--social-rule);
  }

  .social-method__step {
    display: grid;
    grid-template-columns: minmax(5rem, 0.32fr) minmax(0, 1fr);
    gap: 1.5rem;
    min-height: 15rem;
    padding-block: clamp(1.75rem, 3vw, 2.6rem);
    border-bottom: var(--social-rule);
  }

  .social-method__number {
    font-family: var(--type-display);
    font-size: clamp(3.2rem, 5vw, 5rem);
    font-weight: var(--type-display-weight);
    line-height: 0.8;
    color: var(--social-accent);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-method__step:hover .social-method__number {
    transform: translateX(0.2rem);
  }

  .social-method__step p {
    max-width: 34rem;
  }

  .social-cta {
    padding-block: var(--space-section-wide);
    color: var(--brand-ink);
    background: var(--site-mustard);
    border-block: var(--social-rule);
  }

  .social-cta :global(.eyebrow),
  .social-cta h2,
  .social-cta p {
    color: var(--brand-ink);
  }

  .social-cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: end;
  }

  .social-cta__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .social-cta__lead {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 700;
  }

  .social-cta .btn-primary {
    margin-top: 0.5rem;
  }

  @media (max-width: 1199.98px) {
    .social-problems__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .social-problem:nth-child(odd) {
      border-left: 0;
    }

    .social-problem:nth-child(n + 3) {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: var(--social-rule);
    }
  }

  @media (max-width: 991.98px) {
    .social-hero__grid,
    .social-good__grid,
    .social-cta__grid {
      grid-template-columns: 1fr;
    }

    .social-hero__collage {
      min-height: 23rem;
      max-width: 40rem;
    }

    .social-section__head {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .social-good__intro {
      position: static;
    }
  }

  @media (max-width: 767.98px) {
    .social-hero {
      padding-top: 3.5rem;
    }

    .social-hero h1 {
      font-size: clamp(3rem, 13vw, 4.6rem);
    }

    .social-problems__grid,
    .social-method__grid {
      grid-template-columns: 1fr;
    }

    .social-problem,
    .social-problem:nth-child(n + 3) {
      margin-top: 0;
      padding: 1.65rem 0 1.9rem;
      border-left: 0;
      border-top: var(--social-rule);
    }

    .social-problems__grid {
      border-top: 0;
    }

    .social-problem__mark {
      margin-bottom: 1.5rem;
    }

    .social-method__step {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      min-height: 0;
    }
  }

  @media (max-width: 575.98px) {
    .social-hero__collage {
      min-height: 19rem;
    }

    .social-hero__paper {
      inset: 11% 4% 14% 6%;
      box-shadow: var(--print-offset-sm) var(--site-mustard);
    }

    .social-hero__megaphone {
      width: 88%;
      left: 1%;
      top: 3%;
    }

    .social-hero__bubble--coral {
      left: 2%;
    }

    .social-hero__bubble--teal {
      right: 0;
      bottom: 6%;
    }

    .social-hero__annotation {
      top: 2%;
      right: 0;
      font-size: 0.68rem;
    }

    .social-hero__label {
      font-size: 0.62rem;
    }

    .social-hero__label--one {
      top: 19%;
    }

    .social-hero__label--two {
      top: 47%;
    }

    .social-hero__label--three {
      bottom: 11%;
    }

    .social-good__item {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.85rem;
    }

    .social-method__step {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .social-method__number {
      font-size: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-hero__bubble,
    .social-hero__megaphone {
      animation: none;
    }

    .social-hero__collage:hover .social-hero__megaphone,
    .social-hero__collage:hover .social-hero__bubble,
    .social-hero__collage:hover .social-hero__annotation,
    .social-hero__collage:hover .social-hero__label,
    .social-problem:hover,
    .social-problem:hover .social-problem__mark,
    .social-good__item:hover::after,
    .social-method__step:hover .social-method__number {
      transform: none;
    }
  }
</style>
