---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIcon from '../components/HomeIcon.astro';

const pageTitle = 'Social Media - Digitful';
const pageDescription = 'Digitful helps businesses build recognizable social media around a clear point of view, the right audience, and a useful content system.';
const pageCanonical = 'https://digitful.ca/social-media/';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageCanonical}>
  <main class="page-theme page-theme--social social-page">
    <section class="social-hero">
      <div class="container social-hero__grid">
        <div class="social-hero__copy">
          <span class="eyebrow">Social media</span>
          <h1>Social media should give people a reason to pay attention.</h1>
          <p class="lead">A clear point of view, a recognizable voice, and content built for the people you actually want to reach.</p>
          <div class="social-hero__actions">
            <a href="/contact/?service=social-media" class="btn btn-primary btn-lg px-4">
              <span>Tell us what’s stuck</span><span class="social-button-arrow" aria-hidden="true"></span>
            </a>
            <a href="/what-we-build/" class="btn btn-ghost btn-lg">See what we build</a>
          </div>
        </div>

        <div class="social-hero__collage" aria-hidden="true">
          <span class="social-hero__paper"></span>
          <span class="social-hero__bubble social-hero__bubble--coral"></span>
          <span class="social-hero__bubble social-hero__bubble--teal"></span>

        </div>
      </div>
    </section>

    <section class="social-section social-problems" aria-labelledby="social-problems-heading">
      <div class="container">
        <header class="social-section__head social-section__head--problems">
          <span class="eyebrow">Where it usually gets stuck</span>
          <h2 id="social-problems-heading">Being active is not the same as being memorable.</h2>
        </header>

        <div class="social-problems__field" role="list">
          <article class="social-problem social-problem--one" role="listitem">
            <span class="icon-disc icon-disc--mustard social-problem__icon"><HomeIcon name="message" /></span>
            <div>
              <h3>The brand could be anyone</h3>
              <p>Polished content is not enough if there is nothing distinctive to remember.</p>
            </div>
          </article>

          <article class="social-problem social-problem--two" role="listitem">
            <span class="icon-disc icon-disc--teal social-problem__icon"><HomeIcon name="clipboard" /></span>
            <div>
              <h3>The message keeps changing</h3>
              <p>Every post says something different, so the brand never becomes clear.</p>
            </div>
          </article>

          <article class="social-problem social-problem--three" role="listitem">
            <span class="icon-disc icon-disc--coral social-problem__icon"><HomeIcon name="nodes" /></span>
            <div>
              <h3>You are talking to everyone</h3>
              <p>The content gets seen, but not necessarily by the people you want more of.</p>
            </div>
          </article>

          <article class="social-problem social-problem--four" role="listitem">
            <span class="icon-disc icon-disc--mustard social-problem__icon"><HomeIcon name="clock" /></span>
            <div>
              <h3>Posting becomes the goal</h3>
              <p>The calendar stays full, but it is hard to say what all that activity is doing for the business.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="social-good" aria-labelledby="social-good-heading">
      <div class="container">
        <header class="social-good__head">
          <span class="eyebrow">What good social media should do</span>
          <h2 id="social-good-heading">Give people something to recognize, remember, and act on.</h2>
        </header>

        <div class="social-good__path" role="list">
          <svg class="social-good__line" viewBox="0 0 1000 100" preserveAspectRatio="xMinYMin meet" aria-hidden="true">
            <path d="M20 65 C110 25 180 95 260 65 S420 25 500 50 S670 90 740 40 S890 50 975 20" />
            <circle cx="20" cy="65" r="8" fill="var(--site-accent)" />
            <circle cx="260" cy="65" r="8" fill="var(--site-mustard)" />
            <circle cx="500" cy="50" r="8" fill="var(--site-teal)" />
            <circle cx="740" cy="40" r="8" fill="var(--site-accent)" />
            <path class="social-good__arrow" d="M955 10 L980 20 L963 38" />
          </svg>

          <article class="social-good__stage social-good__stage--one" role="listitem">
            <h3>Build recognition</h3>
            <p>People should start to recognize how you think and what makes the business different.</p>
          </article>

          <article class="social-good__stage social-good__stage--two" role="listitem">
            <h3>Reach the right people</h3>
            <p>Good content reflects what your audience actually cares about.</p>
          </article>

          <article class="social-good__stage social-good__stage--three" role="listitem">
            <h3>Build familiarity</h3>
            <p>Not everyone is ready today. Give people a reason to remember you later.</p>
          </article>

          <article class="social-good__stage social-good__stage--four" role="listitem">
            <h3>Create a next step</h3>
            <p>Attention should lead naturally somewhere useful.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="social-section social-method" aria-labelledby="social-method-heading">
      <div class="container">
        <header class="social-section__head social-section__head--method">
          <span class="eyebrow">How we work on it</span>
          <h2 id="social-method-heading">A useful social system starts before the first post.</h2>
        </header>

        <div class="social-method__flow" role="list">
          <article class="social-method__step social-method__step--one" role="listitem">
            <span class="social-method__number">01</span>
            <div>
              <h3>Get the message clear</h3>
              <p>Define what the business should be known for and what is worth repeating.</p>
            </div>
          </article>

          <article class="social-method__step social-method__step--two" role="listitem">
            <span class="social-method__number">02</span>
            <div>
              <h3>Focus on the right people</h3>
              <p>Shape the content around who you actually want to reach.</p>
            </div>
          </article>

          <article class="social-method__step social-method__step--three" role="listitem">
            <span class="social-method__number">03</span>
            <div>
              <h3>Build the content system</h3>
              <p>Create repeatable themes, formats, and a publishing rhythm the team can maintain.</p>
            </div>
          </article>

          <article class="social-method__step social-method__step--four" role="listitem">
            <span class="social-method__number">04</span>
            <div>
              <h3>Learn from the response</h3>
              <p>Look beyond likes and reach. See what earns attention and creates real interest.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="social-cta" aria-labelledby="social-cta-heading">
      <div class="container social-cta__grid">
        <div class="social-cta__copy-block">
          <span class="eyebrow">The next step</span>
          <h2 id="social-cta-heading">Social media should not end at the post.</h2>
          <p>If the content feels generic, inconsistent, or busy without a clear purpose, we can help fix the system behind it.</p>
          <a href="/contact/?service=social-media" class="btn btn-primary btn-lg px-4">
            <span>Tell us what’s not working</span><span class="social-button-arrow" aria-hidden="true"></span>
          </a>
        </div>

        <div class="social-cta__visual" aria-hidden="true">
          <span class="social-cta__orb"></span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .social-page {
    --social-rule: var(--ds-rule-strong);
    overflow: clip;
  }

  .social-button-arrow {
    display: inline-block;
    margin-left: 0.65rem;
    font-weight: 900;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .btn:hover .social-button-arrow {
    transform: translateX(0.2rem);
  }

  .social-hero {
    padding-block: clamp(3.75rem, 7vw, 6.75rem) var(--space-section);
    border-bottom: var(--social-rule);
  }

  .social-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .social-hero__copy {
    max-width: 52rem;
  }

  .social-hero__copy .eyebrow,
  .social-section__head .eyebrow,
  .social-good__head .eyebrow,
  .social-cta .eyebrow {
    margin-bottom: 1.1rem;
  }

  .social-hero h1 {
    max-width: 11ch;
    margin: 0;
    font-size: var(--type-display-xl);
    line-height: 0.91;
    letter-spacing: -0.045em;
  }

  .social-hero .lead {
    max-width: 41rem;
    margin: 1.55rem 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.52;
  }

  .social-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 1.6rem;
  }

  .social-hero__collage {
    position: relative;
    min-height: 29rem;
    isolation: isolate;
  }

  .social-hero__paper {
    position: absolute;
    inset: 13% 8% 12% 17%;
    z-index: -2;
    background:
      linear-gradient(var(--site-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--site-border-subtle) 1px, transparent 1px),
      var(--site-surface);
    background-size: var(--technical-grid-size) var(--technical-grid-size);
    border: var(--social-rule);
    box-shadow: var(--print-offset-lg) var(--site-mustard);
    transform: rotate(-1.6deg);
  }

  .social-hero__bubble {
    position: absolute;
    z-index: -1;
    border: var(--social-rule);
    border-radius: 50%;
    transition: transform var(--motion-standard) var(--motion-ease);
    animation: social-bubble-in var(--motion-standard) var(--motion-ease) both;
  }

  .social-hero__bubble--coral {
    width: clamp(7rem, 12vw, 10rem);
    height: clamp(7rem, 12vw, 10rem);
    top: 2%;
    right: 7%;
    background: var(--site-accent);
    animation-delay: 30ms;
  }

  .social-hero__bubble--teal {
    width: clamp(5.75rem, 9vw, 7.75rem);
    height: clamp(5.75rem, 9vw, 7.75rem);
    left: 4%;
    bottom: 10%;
    background: var(--site-teal);
    animation-delay: 90ms;
  }

  .social-hero__megaphone {
    position: absolute;
    width: 88%;
    max-width: 34rem;
    left: 5%;
    top: 5%;
    z-index: 1;
    overflow: visible;
    filter: drop-shadow(0.42rem 0.5rem 0 var(--brand-ink));
    transform: rotate(-5deg);
    transition: transform var(--motion-standard) var(--motion-ease);
    animation: social-collage-in var(--motion-standard) var(--motion-ease) both;
  }

  .social-hero__megaphone-body {
    fill: var(--brand-paper);
    stroke: var(--brand-ink);
    stroke-width: 10;
    stroke-linejoin: round;
  }

  .social-hero__megaphone-handle {
    fill: var(--brand-ink);
    stroke: var(--brand-ink);
    stroke-width: 8;
    stroke-linejoin: round;
  }

  .social-hero__megaphone-cut {
    fill: var(--site-surface);
    stroke: var(--brand-ink);
    stroke-width: 9;
  }

  .social-hero__sound {
    fill: none;
    stroke: var(--brand-ink);
    stroke-width: 9;
    stroke-linecap: round;
  }

  .social-hero__collage:hover .social-hero__megaphone {
    transform: rotate(-2.5deg) translate(0.3rem, -0.1rem);
  }

  .social-hero__collage:hover .social-hero__bubble--coral {
    transform: translate(0.45rem, -0.35rem);
  }

  .social-hero__collage:hover .social-hero__bubble--teal {
    transform: translate(-0.4rem, 0.3rem);
  }

  @keyframes social-bubble-in {
    from { opacity: 0; transform: scale(0.86); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes social-collage-in {
    from { opacity: 0; transform: rotate(-7deg) translateY(0.55rem); }
    to { opacity: 1; transform: rotate(-5deg) translateY(0); }
  }

  .social-section {
    padding-block: var(--space-section);
  }

  .social-section__head,
  .social-good__head {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: var(--space-editorial-gap);
    align-items: end;
    margin-bottom: clamp(2.4rem, 5vw, 4.5rem);
  }

  .social-section__head .eyebrow,
  .social-good__head .eyebrow {
    align-self: start;
  }

  .social-section__head h2,
  .social-good__head h2,
  .social-cta h2 {
    margin: 0;
    font-size: var(--type-display-lg);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .social-problems__field {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 5rem;
    align-items: start;
  }

  .social-problem {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
    width: 100%;
    padding-top: 1rem;
    border-top: var(--social-rule);
  }

  .social-problem::after {
    content: '';
    position: absolute;
    color: var(--site-text);
    font-family: var(--type-display);
    font-size: clamp(1.7rem, 2.5vw, 2.35rem);
    font-weight: 800;
    line-height: 1;
  }

  .social-problem:nth-child(even) { margin-top: 5rem; }
  .social-problem::after { right: -4rem; top: 3rem; }
  .social-problem:nth-child(even)::after { left: -4rem; top: auto; bottom: -3rem; transform: rotate(100deg); }
  .social-problem:last-child::after { display: none; }

  .social-problem__icon {
    width: 4.75rem;
    height: 4.75rem;
    margin-top: -0.55rem;
    border: var(--social-rule);
  }

  .social-problem__icon :global(svg) {
    width: 2.2rem;
    height: 2.2rem;
  }

  .social-problem h3,
  .social-good__stage h3,
  .social-method__step h3 {
    margin: 0 0 0.55rem;
    font-size: var(--type-title-lg);
    line-height: 1;
  }

  .social-problem p,
  .social-good__stage p,
  .social-method__step p,
  .social-cta p {
    margin: 0;
    line-height: 1.55;
  }

  .social-problem p {
    max-width: 29rem;
  }

  .social-good {
    padding-block: var(--space-section-wide);
    color: var(--brand-ink);
    background: var(--site-teal);
    border-block: var(--social-rule);
  }

  .social-good :global(.eyebrow),
  .social-good h2,
  .social-good h3,
  .social-good p {
    color: var(--brand-ink);
  }

  .social-good__head {
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    margin-bottom: clamp(3.25rem, 6vw, 5.5rem);
  }

  .social-good__path {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2.6rem);
    min-height: 18rem;
    padding-top: 4.2rem;
  }

  .social-good__line {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 8.5rem;
    overflow: visible;
    fill: none;
    stroke: var(--brand-ink);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .social-good__stage {
    position: relative;
    padding-top: 1.1rem;
  }

  .social-good__stage--two { margin-top: 1rem; }
  .social-good__stage--three { margin-top: 0.25rem; }
  .social-good__stage--four { margin-top: -1.15rem; }

  .social-good__dot {
    position: absolute;
    top: -1.55rem;
    left: 0.25rem;
    width: 1.35rem;
    height: 1.35rem;
    background: var(--site-accent);
    border: 3px solid var(--brand-ink);
    border-radius: 50%;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-good__stage--two .social-good__dot { background: var(--site-mustard); }
  .social-good__stage--three .social-good__dot { background: var(--site-teal); }
  .social-good__stage--four .social-good__dot { background: var(--site-accent); }

  .social-good__stage:hover .social-good__dot {
    transform: translateX(0.35rem);
  }

  .social-good__stage p {
    max-width: 16rem;
    font-size: 0.98rem;
  }

  .social-method__flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.35rem, 3vw, 3rem);
  }

  .social-method__flow::before {
    content: '';
    position: absolute;
    top: 2.65rem;
    right: 3%;
    left: 3%;
    border-top: var(--social-rule);
    z-index: -1;
  }

  .social-method__step {
    position: relative;
    padding-top: 6.1rem;
  }

  .social-method__number {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    width: 5.3rem;
    height: 5.3rem;
    place-items: center;
    color: var(--brand-ink);
    background: var(--site-accent);
    border: var(--social-rule);
    border-radius: 50%;
    font-family: var(--type-display);
    font-size: 2.2rem;
    font-weight: var(--type-display-weight);
    line-height: 1;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .social-method__step--two .social-method__number { background: var(--site-mustard); }
  .social-method__step--three .social-method__number { background: var(--site-teal); }
  .social-method__step--four .social-method__number { background: var(--site-accent); }

  .social-method__step:hover .social-method__number {
    transform: translateY(-0.25rem) rotate(-2deg);
  }

  .social-method__step p {
    max-width: 18rem;
  }

  .social-cta {
    padding-block: var(--space-section-wide);
    color: var(--brand-ink);
    background: var(--site-mustard);
    border-block: var(--social-rule);
  }

  .social-cta :global(.eyebrow),
  .social-cta h2,
  .social-cta p {
    color: var(--brand-ink);
  }

  .social-cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.7fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .social-cta__copy-block {
    display: grid;
    justify-items: start;
    gap: 1.2rem;
  }

  .social-cta__copy-block .eyebrow {
    margin-bottom: 0;
  }

  .social-cta__copy-block p {
    max-width: 37rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
  }

  .social-cta__visual {
    position: relative;
    min-height: 17rem;
  }

  .social-cta__orb {
    position: absolute;
    width: 10.5rem;
    height: 10.5rem;
    top: 0.25rem;
    right: 3%;
    background: var(--site-accent);
    border: var(--social-rule);
    border-radius: 50%;
  }

  .social-cta__visual svg {
    position: absolute;
    inset: 0.4rem 0 auto;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0.32rem 0.38rem 0 var(--brand-ink));
    transition: transform var(--motion-standard) var(--motion-ease);
  }

  .social-cta__visual:hover svg {
    transform: rotate(-1.5deg) translateX(-0.2rem);
  }

  .social-cta__barrels,
  .social-cta__bridge {
    fill: var(--brand-paper);
    stroke: var(--brand-ink);
    stroke-width: 9;
    stroke-linejoin: round;
  }

  .social-cta__lenses {
    fill: var(--brand-ink);
    stroke: var(--brand-ink);
    stroke-width: 9;
  }

  .social-cta__rays {
    fill: none;
    stroke: var(--brand-ink);
    stroke-width: 8;
    stroke-linecap: round;
  }

  @media (max-width: 991.98px) {
    .social-hero__grid,
    .social-cta__grid {
      grid-template-columns: 1fr;
    }

    .social-hero__collage {
      min-height: 24rem;
      max-width: 39rem;
      width: 100%;
    }

    .social-section__head,
    .social-good__head {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .social-problems__field {
      gap: 3rem;
    }

    .social-method__flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 3rem;
    }

    .social-method__flow::before {
      display: none;
    }

    .social-cta__visual {
      max-width: 31rem;
      width: 100%;
    }
  }

  @media (max-width: 767.98px) {
    .social-hero {
      padding-top: 2.75rem;
      padding-bottom: 3.5rem;
    }

    .social-hero h1 {
      max-width: none;
      font-size: clamp(3rem, 14.2vw, 4.25rem);
      line-height: 0.9;
      text-wrap: balance;
    }

    .social-hero .lead {
      max-width: 34rem;
      margin-top: 1.25rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .social-hero__actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      margin-top: 1.35rem;
    }

    .social-hero__actions .btn {
      width: 100%;
      justify-content: center;
    }

    .social-hero__collage {
      min-height: 20rem;
      margin-top: 1.45rem;
    }

    .social-hero__paper {
      inset: 14% 6% 8% 13%;
      box-shadow: var(--print-offset-sm) var(--site-mustard);
    }

    .social-hero__bubble--coral {
      width: 7.6rem;
      height: 7.6rem;
      top: 1%;
      right: 1%;
    }

    .social-hero__bubble--teal {
      width: 5.8rem;
      height: 5.8rem;
      left: 1%;
      bottom: 7%;
    }

    .social-hero__megaphone {
      width: 91%;
      left: 2%;
      top: 2%;
    }

    .social-section {
      padding-block: 3.6rem;
    }

    .social-section__head,
    .social-good__head {
      margin-bottom: 2.6rem;
    }

    .social-problems__field {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.65rem;
      min-height: 0;
    }

    .social-problem {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      left: auto;
      width: 92%;
      padding: 0 0 1.2rem;
      border-top: 0;
      border-bottom: var(--social-rule);
      grid-template-columns: 4.9rem minmax(0, 1fr);
      gap: 1rem;
    }

    .social-problem--one { margin-left: 0; }
    .social-problem--two { margin-left: 8%; }
    .social-problem--three { margin-left: 1.5%; }
    .social-problem--four { margin-left: 7%; }

