---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Paid Ads - Digitful';
const pageDescription = 'Digitful builds paid acquisition systems around qualified demand and clearer conversion paths.';
const pageCanonical = 'https://digitful.ca/paid-ads/';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageCanonical}>
  <main class="paid-page">
  <section class="paid-hero" aria-labelledby="paid-title">
  <div class="container paid-hero__grid">
  <div class="paid-hero__copy">
  <h1 id="paid-title">A clever ad is not a campaign.</h1>
  <p>Ads work when the offer makes sense to the people seeing it and the page they land on backs it up. We build Google and Meta campaigns around both.</p>
  <a class="btn btn-primary btn-lg paid-cta" href="/contact/?service=paid-ads">Tell us what's stuck →</a>
  </div>
  <figure class="paid-hero__art" aria-hidden="true"><picture>
  <source media="(max-width: 767.98px)" srcset="/assets/collage/paid/paid-billboard-road-mobile.webp" type="image/webp" />
  <img src="/assets/collage/paid/paid-billboard-road-desktop.webp" width="1200" height="800" alt="" decoding="async" fetchpriority="high" />
  </picture></figure>
  </div>
  </section>
  <section class="paid-problems" aria-labelledby="problems-title"><div class="container">
  <p class="paid-label">Where it gets stuck</p>
  <h2 id="problems-title">Spending is easy. Knowing what it bought is harder.</h2>
  <ul class="paid-problems__list">
  <li><h3>Clicks, not customers.</h3><p>The ads get attention. The leads aren't worth calling.</p></li>
  <li><h3>The offer is vague.</h3><p>If people can't tell what you're selling, they keep scrolling.</p></li>
  <li><h3>The page breaks the promise.</h3><p>The ad says one thing. The landing page says another.</p></li>
  <li><h3>Nobody decides anything.</h3><p>The budget renews every month. The decisions don't.</p></li>
  </ul></div></section>
  <section class="paid-business" aria-labelledby="business-title"><div class="container">
  <p class="paid-label">Business priorities</p>
  <div class="paid-business__grid">
  <h2 id="business-title">Start with the business you want more of.</h2>
  <p>Before we make an ad, we work out what you want to sell, which customers you want more of, and what you can afford to pay to win each one. That decides the offer, the audience, and where the money goes.</p>
  </div></div></section>
  <section class="paid-work" aria-labelledby="work-title"><div class="container">
  <h2 id="work-title">How we work</h2>
  <ol class="paid-work__list">
  <li><div><h3>Set the target.</h3><p>Agree on what a good customer is worth and what you'll pay to get one.</p></div></li>
  <li><div><h3>Build the campaign.</h3><p>Ads, targeting, and landing pages that all say the same thing.</p></div></li>
  <li><div><h3>Run it.</h3><p>Manage the budget as the campaign runs, not once a quarter.</p></div></li>
  <li><div><h3>Keep what works.</h3><p>Test messages, track which leads become customers, and move money to what earns it.</p></div></li>
  </ol></div></section>
  <section class="paid-close" aria-labelledby="close-title"><div class="container">
  <p class="paid-label">Next step</p>
  <h2 id="close-title">Spending money and not sure what it's buying?</h2>
  <p>Bring what you're running now. We'll work out what to keep, what to change, and what to stop.</p>
  <a class="btn btn-primary btn-lg paid-cta" href="/contact/?service=paid-ads">Talk about your campaign →</a>
  </div></section>
  </main>
</BaseLayout>

<style>
  .paid-page { color: var(--site-text); }
  .paid-page h1, .paid-page h2 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -.025em;
    margin: 0;
  }
  .paid-page p { font-size: 1.125rem; line-height: 1.6; margin: 0; }
  .paid-hero { padding-block: 64px 56px; }
  .paid-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 36px;
  }
  .paid-hero h1 { font-size: clamp(64px, 6.25vw, 90px); line-height: .96; max-width: 580px; }
  .paid-hero__copy p { max-width: 510px; margin-block: 28px; }
  .paid-cta { border: 2px solid var(--site-border); white-space: normal; }
  .paid-hero__art { margin: 0; }
  .paid-hero__art img { display: block; width: 100%; height: auto; }
  .paid-business {
    background: var(--site-teal);
    border-block: 2px solid #191a1b;
    padding-block: 48px;
  }
  .paid-business__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 60px;
  }
  .paid-business h2, .paid-business p { color: #191a1b; }
  .paid-page h2 { font-size: clamp(40px, 3.7vw, 54px); line-height: 1.02; max-width: 500px; }
  .paid-business p { max-width: 500px; padding-top: 3px; }
  .paid-page h3 { font-family: var(--font-display); font-size: 30px; font-weight: 800; line-height: 1.1; margin: 0 0 10px; letter-spacing: -.015em; }
  .paid-page .paid-label { font-size: 13px; font-weight: 700; margin-bottom: 18px; letter-spacing: .06em; }
  .paid-problems { padding-block: 42px 48px; border-top: 1px solid var(--site-border-subtle); }
  .paid-problems h2 { max-width: 700px; }
  .paid-problems__list, .paid-work__list { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 60px; margin: 30px 0 0; padding: 0; }
  .paid-problems__list { list-style: none; }
  .paid-problems__list li { border-top: 1px solid var(--site-border-subtle); padding-top: 20px; }
  .paid-problems__list p, .paid-work__list p { max-width: 500px; }
  .paid-work { padding-block: 48px; }
  .paid-work__list { list-style: none; counter-reset: paid-step; }
  .paid-work__list li { counter-increment: paid-step; display: flex; align-items: baseline; gap: 18px; border-top: 1px solid var(--site-border-subtle); padding-top: 20px; }
  .paid-work__list li::before { content: counter(paid-step) "."; font-size: 18px; font-weight: 700; flex: 0 0 20px; color: var(--site-text); }
  .paid-work__list li > div { min-width: 0; }
  .paid-close { padding-block: 42px 54px; background: var(--site-surface); border-top: 2px solid var(--site-border); }
  .paid-close h2 { max-width: 720px; }
  .paid-close p:not(.paid-label) { max-width: 680px; margin-block: 22px; }
  @media (max-width: 991.98px) {
    .paid-hero { padding-block: 44px; }
    .paid-hero__grid { gap: 24px; }
    .paid-hero h1 { font-size: 64px; }
    .paid-business__grid, .paid-problems__list, .paid-work__list { gap: 28px 30px; }
  }
  @media (max-width: 767.98px) {
    .paid-hero { padding-block: 34px 30px; }
    .paid-hero__grid { grid-template-columns: 1fr; gap: 24px; }
    .paid-hero h1 { font-size: clamp(53px, 15.4vw, 66px); max-width: 440px; }
    .paid-hero__copy p { margin-block: 22px; }
    .paid-hero__art { width: min(100%, 400px); margin-inline: auto; }
    .paid-business { padding-block: 32px; }
    .paid-business__grid { grid-template-columns: 1fr; gap: 20px; }
    .paid-page h2 { font-size: 42px; }
    .paid-problems, .paid-work { padding-block: 32px; }
    .paid-problems__list, .paid-work__list { grid-template-columns: 1fr; gap: 24px; margin-top: 24px; }
    .paid-close { padding-block: 32px 36px; }
  }
</style>
