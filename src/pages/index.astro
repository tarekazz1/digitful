---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstantSnapshot from '../components/InstantSnapshot.astro';

const pageTitle = 'Digitful - Real Growth Systems';
const pageDescription =
  'Digitful builds strategy, acquisition, and automation systems for businesses that want durable growth.';
const pageCanonical = 'https://digitful.ca/';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageCanonical}>
  <main class="home-page">
    <section class="home-hero">
      <div class="container">
        <div class="home-hero__grid">
          <div class="home-hero__copy">
            <span class="eyebrow">Growth systems</span>
            <h1>Marketing works better when the parts talk to each other.</h1>
            <p class="lead">
              Strategy, acquisition, and automation built as one system instead of a pile of disconnected tactics.
            </p>
            <div class="home-hero__actions">
              <a href="/contact/" class="btn btn-primary btn-lg px-4">Talk through the problem</a>
              <a href="/what-we-build/" class="btn btn-link-quiet btn-lg">See what we build</a>
            </div>
          </div>

          <div class="home-hero__visual" aria-hidden="true">
            <div class="home-system-map">
              <div class="home-system-map__meta">
                <span>Growth system / signal map</span>
                <span>01—04</span>
              </div>
              <div class="home-system-map__flow">
                <div class="home-system-map__node">
                  <span class="home-system-map__number">01</span>
                  <strong>Strategy</strong>
                  <small>Message + priorities</small>
                </div>
                <div class="home-system-map__node">
                  <span class="home-system-map__number">02</span>
                  <strong>Acquisition</strong>
                  <small>Search + social + paid</small>
                </div>
                <div class="home-system-map__node">
                  <span class="home-system-map__number">03</span>
                  <strong>Handoff</strong>
                  <small>Clear next steps</small>
                </div>
                <div class="home-system-map__node home-system-map__node--accent">
                  <span class="home-system-map__number">04</span>
                  <strong>Automation</strong>
                  <small>Fewer manual gaps</small>
                </div>
              </div>
            </div>
            <span class="home-hero__note">less friction between the parts</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="home-fix-heading">
      <div class="container">
        <header class="home-section__head">
          <span class="eyebrow">Where things usually go wrong</span>
          <h2 id="home-fix-heading">More traffic won’t fix a messy system.</h2>
        </header>

        <div class="home-issue-grid" role="list">
          <article class="home-issue" role="listitem">
            <span class="home-item-number">01</span>
            <h3>Unclear message</h3>
            <p>People shouldn’t need a committee meeting to understand what you do.</p>
          </article>
          <article class="home-issue" role="listitem">
            <span class="home-item-number">02</span>
            <h3>Leaky conversion path</h3>
            <p>Interest is useful. A clear next step is better.</p>
          </article>
          <article class="home-issue" role="listitem">
            <span class="home-item-number">03</span>
            <h3>Slow follow-up</h3>
            <p>If the next step relies on memory, it probably needs a system.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section home-services" aria-labelledby="home-services-heading">
      <div class="container">
        <header class="home-section__head">
          <span class="eyebrow">What we actually do</span>
          <h2 id="home-services-heading">Four parts. One growth system.</h2>
        </header>

        <div class="home-services-grid">
          <a href="/social-media/" class="home-service">
            <span class="home-service__number">01</span>
            <div>
              <h3>Social Media</h3>
              <p>Make the brand clearer, more useful, and easier to remember.</p>
            </div>
            <span class="home-service__arrow" aria-hidden="true">↗</span>
          </a>

          <a href="/seo/" class="home-service">
            <span class="home-service__number">02</span>
            <div>
              <h3>SEO</h3>
              <p>Show up for the searches that can actually turn into business.</p>
            </div>
            <span class="home-service__arrow" aria-hidden="true">↗</span>
          </a>

          <a href="/paid-ads/" class="home-service">
            <span class="home-service__number">03</span>
            <div>
              <h3>Paid Ads</h3>
              <p>Put budget behind the right message, audience, and next step.</p>
            </div>
            <span class="home-service__arrow" aria-hidden="true">↗</span>
          </a>

          <a href="/automation/" class="home-service">
            <span class="home-service__number">04</span>
            <div>
              <h3>Process Automation</h3>
              <p>Remove the repetitive handoffs that slow people down and lose leads.</p>
            </div>
            <span class="home-service__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="home-fit" aria-labelledby="home-fit-heading">
      <div class="container">
        <div class="home-fit__grid">
          <header class="home-fit__intro">
            <span class="eyebrow">Probably a good fit if...</span>
            <h2 id="home-fit-heading">The business is moving. The system is lagging behind.</h2>
          </header>

          <div class="home-fit__list" role="list">
            <article class="home-fit__item" role="listitem">
              <span class="home-item-number">01</span>
              <div>
                <h3>You already have demand</h3>
                <p>The problem is not whether people care. It is what happens next.</p>
              </div>
            </article>
            <article class="home-fit__item" role="listitem">
              <span class="home-item-number">02</span>
              <div>
                <h3>Priorities keep competing</h3>
                <p>Too many channels, tools, and “urgent” ideas. Not enough signal.</p>
              </div>
            </article>
            <article class="home-fit__item" role="listitem">
              <span class="home-item-number">03</span>
              <div>
                <h3>Manual work keeps multiplying</h3>
                <p>If the same task happens every week, someone should ask why.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <InstantSnapshot />

    <section class="home-cta" aria-labelledby="home-cta-heading">
      <div class="container">
        <div class="home-cta__grid">
          <header>
            <span class="eyebrow">Next move</span>
            <h2 id="home-cta-heading">Bring the messy version.</h2>
          </header>
          <div>
            <p>
              The funnel, the tools, the bottlenecks, the things nobody has had time to fix. We’ll help you work out what matters first.
            </p>
            <div class="home-cta__actions">
              <a href="/contact/" class="btn btn-primary btn-lg px-4">Talk to Digitful</a>
              <a
                href="https://chatgpt.com/g/g-DmZRaiTLa-digitful-marketing-analyst"
                target="_blank"
                rel="noopener"
                class="btn btn-ghost btn-lg px-4"
              >
                Try the Digitful GPT
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
