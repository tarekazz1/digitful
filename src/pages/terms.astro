---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Terms of Service - Digitful';
const pageDescription = "Digitful's terms of service and conditions of use.";
const pageCanonical = 'https://digitful.ca/terms/';
---
<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageCanonical}>
  <main class="utility-page">
    <section class="service-hero text-center">
      <div class="container">
        <span class="eyebrow mb-3">Terms</span>
        <h1 class="mb-3">Terms of Service</h1>
        <p class="lead mb-0">The basic terms that apply when you use this site or contact us.</p>
      </div>
    </section>

    <section class="terms-content py-6">
      <div class="container">
        <div class="legal-shell">
          <h2>Acceptance of Terms</h2>
          <p class="mb-4">
            By accessing or using Digitful's services, you agree to these terms.
          </p>

          <h2>Services</h2>
          <p>Digitful provides services including:</p>
          <ul class="mb-4">
            <li>Social media strategy</li>
            <li>SEO</li>
            <li>Paid advertising</li>
            <li>Process automation</li>
          </ul>

          <h2>Client Responsibilities</h2>
          <p>Clients are responsible for:</p>
          <ul class="mb-4">
            <li>Providing accurate information</li>
            <li>Paying invoices on time</li>
            <li>Following applicable laws and regulations</li>
            <li>Providing necessary access to accounts and tools</li>
          </ul>

          <h2>Limitation of Liability</h2>
          <p class="mb-4">
            Digitful is not liable for indirect, incidental, special, consequential, or punitive
            damages arising from the use of our services.
          </p>

          <h2>Contact</h2>
          <p class="mb-0">
            Questions about these terms can be sent to{' '}
            <a href="mailto:ping@digitful.ca" class="link-primary text-decoration-none">ping@digitful.ca</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main.utility-page {color:var(--site-text);padding:48px 24px 64px;}
  main.utility-page .container {width:100%;max-width:48rem;padding:0;margin-inline:auto;}
  main.utility-page .service-hero {padding:0 0 28px;text-align:left!important;background:none;border:0;}
  main.utility-page .service-hero h1 {font-size:clamp(2.75rem,5vw,3.75rem);line-height:1.02;margin:0 0 16px!important;}
  main.utility-page .service-hero .eyebrow {color:var(--site-text-muted);margin-bottom:12px!important;}
  main.utility-page .service-hero .lead {max-width:none;margin:0!important;font-size:1.125rem;line-height:1.6;}
  main.utility-page section+section {max-width:48rem;margin-inline:auto;padding:28px 0 0!important;border-top:1px solid var(--site-border-subtle);}
  main.utility-page .legal-shell {max-width:none!important;padding:0;border:0;border-radius:0;background:transparent!important;box-shadow:none;}
  main.utility-page .legal-shell h2 {font-size:1.625rem;line-height:1.2;margin:28px 0 12px;}
  main.utility-page .legal-shell h2:first-child {margin-top:0;}
  main.utility-page .legal-shell p,main.utility-page .legal-shell li {font-size:1rem;line-height:1.7;}
  main.utility-page .legal-shell a {color:var(--site-text)!important;text-decoration:underline!important;text-underline-offset:.2em;text-decoration-thickness:1px;}
  main.utility-page .legal-shell a:hover {text-decoration-thickness:2px;}
  main.utility-page .legal-shell a:focus-visible {outline:3px solid currentColor;outline-offset:3px;}
  @media(max-width:575px){main.utility-page {padding:32px 24px 48px;}main.utility-page .service-hero {padding-bottom:24px;}main.utility-page section+section {padding-top:24px!important;}}
</style>
