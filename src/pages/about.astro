---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'About Digitful';
const pageDescription =
  'Meet Digitful, a team with backgrounds in agency work, in-house marketing, and technical operations.';
const pageCanonical = 'https://digitful.ca/about/';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={pageCanonical}>
  <main class="about-proposal">
    <div class="container">
      <section class="about-intro" aria-labelledby="about-title">
        <h1 id="about-title">About Digitful.</h1>
        <div class="about-copy">
          <p class="about-lead">Digitful is a team with backgrounds in agency work, in-house marketing, and technical operations.</p>
          <p>We work across social media, SEO, paid ads, and process automation. That mix of experience helps us consider both what customers see and the work a business needs behind the scenes.</p>
          <a class="about-contact" href="/contact/">Talk to Digitful →</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
.about-proposal { color:var(--site-text); }
.about-intro { display:grid; grid-template-columns: .9fr 1.2fr; gap:80px; padding:64px 0 60px; }
.about-intro h1 { font-family:var(--font-display); font-weight:800; font-size:clamp(72px,7vw,100px); letter-spacing:-.025em; line-height:.98; margin:0; }
.about-copy { border-top:1px solid var(--site-text); padding-top:24px; max-width:640px; }
.about-copy p { font-size:18px; line-height:1.65; margin:0 0 26px; }
.about-copy .about-lead { font-size:24px; line-height:1.45; letter-spacing:-.015em; margin-bottom:24px; }
.about-contact { display:inline-flex; min-height:52px; align-items:center; padding:13px 20px; border:2px solid #191a1b; border-radius:2px; background:#e4c58f; color:#191a1b; font-size:16px; font-weight:700; text-decoration:none; }
.about-contact:hover { color:#191a1b; background:#f0e7d5; text-decoration:underline; text-underline-offset:4px; }
.about-proposal .about-contact:focus-visible { outline:3px solid var(--site-text); outline-offset:5px; color:#191a1b; }
@media(max-width:991.98px) { .about-intro { gap:40px; grid-template-columns:.8fr 1.2fr; padding:44px 0; } .about-intro h1 { font-size:76px; } .about-copy .about-lead { font-size:22px; } }
@media(max-width:767.98px) { .about-intro { display:block; padding:32px 0 36px; } .about-intro h1 { font-size:clamp(52px,14.5vw,72px); max-width:none; line-height:1; margin-bottom:26px; } .about-copy { padding-top:22px; } .about-copy .about-lead { font-size:22px; margin-bottom:20px; } .about-copy p { font-size:17px; line-height:1.6; margin-bottom:24px; } }
</style>
