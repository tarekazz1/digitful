---
export interface Props {
  maxWidth?: string;
  className?: string;
  href?: string;
}

const {
  maxWidth = "150px",
  className = "",
  href = "/"
} = Astro.props;
---

<a
  href={href}
  class={`site-logo d-inline-block flex-grow-0 ${className}`}
  style={`max-width: var(--logo-max-width, ${maxWidth});`}
  aria-label="Digitful home"
>
  <img
    src="/assets/brand/digitful-wordmark-on-dark.svg"
    alt="Digitful"
    class="site-logo__image site-logo__image--dark img-fluid w-100"
    width="1809"
    height="515"
  />
  <img
    src="/assets/brand/digitful-wordmark-on-light.svg"
    alt=""
    aria-hidden="true"
    class="site-logo__image site-logo__image--light img-fluid w-100"
    width="1809"
    height="515"
  />
</a>
