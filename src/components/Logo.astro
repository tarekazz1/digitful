---
// Reusable Logo component
export interface Props {
  maxWidth?: string;
  className?: string;
  href?: string;
}

const { 
  maxWidth = "150px", 
  className = "", 
  href = "/" 
} = Astro.props;
---

<a
  href={href}
  class={`site-logo d-inline-block flex-grow-0 ${className}`}
  style={`max-width: var(--logo-max-width, ${maxWidth});`}
>
  <img
    src="/assets/images/logo.svg"
    alt="Digitful - Digital Marketing Agency"
    class="site-logo__image site-logo__image--dark img-fluid w-100"
    width="400"
    height="160"
  />
  <img
    src="/assets/images/logo-light.svg"
    alt=""
    aria-hidden="true"
    class="site-logo__image site-logo__image--light img-fluid w-100"
    width="400"
    height="160"
  />
</a>
