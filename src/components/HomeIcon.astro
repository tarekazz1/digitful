---
interface Props {
  name: 'message' | 'funnel' | 'clock' | 'megaphone' | 'search' | 'cursor' | 'gear' | 'chart' | 'nodes' | 'clipboard';
  size?: number;
}

const { name, size = 34 } = Astro.props;
---

<svg
  class="home-icon"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {name === 'message' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 13c4-5 10-6 15-3 5 2 8 7 7 12 0 6-5 11-11 12-6 1-12-2-15-7-3-5-1-11 4-14Z" />
      <path d="M15 17c3-3 8-3 11 0s3 8 0 11-8 3-11 0-3-8 0-11Z" />
      <path d="m10 28-4 8 9-3" />
    </g>
  )}

  {name === 'funnel' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 10h34L29 24v13l-10 4V24L7 10Z" />
      <path d="M14 16h20" />
    </g>
  )}

  {name === 'clock' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="17" />
      <path d="M24 14v11l8 5" />
      <path d="M20 5h8" />
    </g>
  )}

  {name === 'megaphone' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="m8 23 24-10v22L8 25v-2Z" />
      <path d="M12 26v9h8l2-6" />
      <path d="M36 18l5-4M37 24h6M36 30l5 4" />
    </g>
  )}

  {name === 'search' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="21" cy="21" r="11" />
      <path d="m29 29 11 11" />
    </g>
  )}

  {name === 'cursor' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 7 36 27l-12 2-6 11L11 7Z" />
      <path d="m25 29 8 9" />
    </g>
  )}

  {name === 'gear' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="7" />
      <path d="M24 5v5M24 38v5M5 24h5M38 24h5M10.5 10.5l3.5 3.5M34 34l3.5 3.5M37.5 10.5 34 14M14 34l-3.5 3.5" />
      <circle cx="24" cy="24" r="15" />
    </g>
  )}

  {name === 'chart' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 40h32" />
      <rect x="10" y="27" width="6" height="10" />
      <rect x="21" y="19" width="6" height="18" />
      <rect x="32" y="10" width="6" height="27" />
      <path d="m10 22 9-6 8 1 11-9" />
    </g>
  )}

  {name === 'nodes' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="24" r="5" />
      <circle cx="34" cy="12" r="5" />
      <circle cx="36" cy="35" r="5" />
      <path d="m16 21 13-7M16 27l15 6M34 17l1 13" />
    </g>
  )}

  {name === 'clipboard' && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 10h-4v32h26V10h-4" />
      <path d="M18 6h12v8H18z" />
      <path d="M17 23h14M17 30h14M17 37h9" />
    </g>
  )}
</svg>
