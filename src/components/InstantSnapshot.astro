---
// Instant growth snapshot component.
---

<section id="snapshot" class="home-snapshot">
  <div class="container">
    <div class="snapshot-shell">
      <div class="home-snapshot__grid">
        <div class="home-snapshot__copy">
          <div class="home-snapshot__heading-row">
            <div>
              <h2>Quick site check</h2>
              <p class="home-snapshot__subheading">See what your website is making harder than it should be.</p>
            </div>
            <img
              src="/assets/collage/home/home-binoculars-480.webp"
              width="480"
              height="480"
              alt=""
              class="home-snapshot__binoculars"
              decoding="async"
              loading="lazy"
            />
          </div>
        </div>

        <div class="home-snapshot__instrument">
          <form id="snapshot-form">
            <div>
              <label for="snapshot-url" class="form-label">Website URL</label>
              <input
                type="url"
                id="snapshot-url"
                class="form-control form-control-lg"
                placeholder="https://yourwebsite.com"
                aria-label="Website URL to analyze"
                required
              />
            </div>

            <div class="home-snapshot__controls">
              <div>
                <label class="form-label d-block">Check for</label>
                <div class="home-snapshot__options">
                  <div class="form-check m-0">
                    <input class="form-check-input" type="radio" name="strategy" id="strategyMobile" value="mobile" checked />
                    <label class="form-check-label" for="strategyMobile">Mobile</label>
                  </div>
                  <div class="form-check m-0">
                    <input class="form-check-input" type="radio" name="strategy" id="strategyDesktop" value="desktop" />
                    <label class="form-check-label" for="strategyDesktop">Desktop</label>
                  </div>
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg px-4">Run the check</button>
            </div>
          </form>

          <div id="snapshot-result" aria-live="polite" class="mt-4"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="/scripts/snapshot.js" is:inline type="module"></script>
</section>
